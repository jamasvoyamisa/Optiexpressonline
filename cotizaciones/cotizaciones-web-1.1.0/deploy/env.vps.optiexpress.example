# Copiar a /opt/optiexpress/cotizaciones-web/.env en el VPS (no subir secretos al repo).
#
# MySQL está en este mismo VPS: MYSQL_HOST=127.0.0.1 (no 148.x ni IP pública).
# Mismo usuario/contraseña que en /opt/optiexpress/backend/.env si compartes servidor.
# Base típica de cotizaciones: optiexpress_central (o la que uses).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=optiexpress_central
MYSQL_SSL=false

NODE_ENV=production
PORT=3080
HOST=127.0.0.1

# Mínimo 32 caracteres en producción (el servidor no arranca si es más corto)
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
# IMPORTANTE: dejar en "/". Nginx hace proxy_pass con barra final y elimina el prefijo
# /cotizaciones, por lo que el Node ve rutas /api/... Si aquí se pone /cotizaciones,
# express-session detecta "pathname mismatch" y NO crea req.session (login se rompe).
SESSION_COOKIE_PATH=/
# strict (por defecto en producción), lax o none (none requiere SESSION_COOKIE_SECURE=true)
# SESSION_COOKIE_SAMESITE=strict

# Orígenes permitidos para credenciales (misma intranet). En prod sin esto, CORS solo refleja mismo origen.
CORS_ORIGIN=https://intranetoptiexpress.net,https://www.intranetoptiexpress.net

ALLOW_ADMIN_FALLBACK=false
