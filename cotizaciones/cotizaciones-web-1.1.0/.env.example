# Copiar a .env (junto a package.json), no subir secretos al repo.
#
# MySQL en el MISMO VPS que esta app: usa siempre 127.0.0.1 (no uses la IP pública del VPS;
# así la conexión va por loopback y no depende del firewall hacia fuera).
#
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tu_usuario
# Si la contraseña contiene # u otros caracteres especiales, usa comillas:
# MYSQL_PASSWORD="tu_contraseña_con_#_hash"
MYSQL_PASSWORD=tu_password
MYSQL_DATABASE=optiexpress_central
MYSQL_SSL=false

NODE_ENV=production
PORT=3080
HOST=127.0.0.1

# Generar: openssl rand -hex 32
SESSION_SECRET=cambiar_por_secreto_largo_aleatorio

# Con HTTPS delante (nginx + certificado válido):
SESSION_COOKIE_SECURE=true

# Si el front se sirve desde otro dominio, lista separada por comas:
# CORS_ORIGIN=https://app.ejemplo.com

# Producción: false (no usar admin/admin). Solo entorno local inicial si hace falta.
ALLOW_ADMIN_FALLBACK=false
