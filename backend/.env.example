# Base de datos MySQL
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=mysql+pymysql://optiexpress_user:optiexpress_password@localhost:3306/optiexpress_online

# Clave secreta para JWT (genera una con: openssl rand -hex 32)
SECRET_KEY=cambiar_por_clave_secreta_segura

# CORS - Orígenes permitidos separados por comas
# Para servidor: http://IP_SERVIDOR,http://localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Producción: DEBUG=false
DEBUG=false
