# Base de datos MySQL
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=mysql+pymysql://optiexpress_user:optiexpress_password@localhost:3306/optiexpress_online

# Clave secreta para JWT (genera una con: openssl rand -hex 32)
SECRET_KEY=cambiar_por_clave_secreta_segura

# CORS - Orígenes permitidos separados por comas
# Para servidor: http://IP_SERVIDOR,http://localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# Local: DEBUG=true habilita, entre otras cosas, POST /nomina/.../calcular-prueba sin NOMINA_CALCULO_PRUEBAS.
# Producción: DEBUG=false
DEBUG=false

# API de nómina (/api/v1/nomina). Por defecto activa; pon false para apagar el router.
NOMINA_ENABLED=true
# Motor de cálculo experimental (Fase 2 pruebas). true solo en desarrollo local.
NOMINA_CALCULO_PRUEBAS=false

# ── FiscalAPI — timbrado nómina (SANDBOX, sin validez fiscal) ───────────────
# 1) Crea cuenta gratis en https://test.fiscalapi.com
# 2) Activa suscripción de prueba y compra/asigna timbres de prueba
# 3) Obtén API Key y Tenant Key en el dashboard
# 4) (Opcional) CSD de prueba en base64 para modo "por valores"
NOMINA_FISCALAPI_ENABLED=false
FISCALAPI_API_URL=https://test.fiscalapi.com
FISCALAPI_API_KEY=
FISCALAPI_TENANT=
FISCALAPI_CSD_CER_BASE64=
FISCALAPI_CSD_KEY_BASE64=
FISCALAPI_CSD_PASSWORD=
FISCALAPI_ORIGIN_EMPLOYER_TIN=
# Nunca true hasta ir a producción real:
FISCALAPI_ALLOW_LIVE=false

# Control de acceso por mantenimiento:
# false = acceso normal para cualquier usuario registrado
# true  = solo Administrador, Gerente o Supervisor
LOGIN_MAINTENANCE_RESTRICTED=false

# Contraseña del usuario admin creado en el primer arranque (instalación nueva, sin
# empleados aún). Si se deja vacío, se genera una aleatoria y se imprime UNA VEZ en el
# log de arranque del backend. Defínela aquí solo si quieres fijarla tú mismo.
ADMIN_DEFAULT_PASSWORD=
