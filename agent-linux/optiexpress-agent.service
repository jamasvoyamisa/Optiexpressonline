[Unit]
Description=Optiexpress Agente Local - Sincronizacion checadores ZKTeco
Documentation=file://%h/agent-local/UBUNTU_SERVER.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Cambia AGENT_DIR por la ruta real donde instalaste el agente
# Ejemplo: /opt/optiexpress-agent o /home/usuario/agent-local
WorkingDirectory=AGENT_DIR
ExecStart=AGENT_DIR/venv/bin/python main.py
Restart=always
RestartSec=15
# Variables de entorno (opcional)
Environment=PYTHONUNBUFFERED=1
# Usuario que ejecuta el servicio (recomendado: crear usuario dedicado)
# User=optiexpress
# Group=optiexpress

[Install]
WantedBy=multi-user.target
